# Private GoHighLevel inbound webhook used only by POST /api/demo-lead.
# Store this as a server-side Vercel Secret; never use a NEXT_PUBLIC_ prefix.
DEMO_WEBHOOK_URL=

# Server-only FirstPromoter key used by POST /api/firstpromoter/signup.
# Store this as a Vercel Secret. Never use a NEXT_PUBLIC_ prefix.
FIRSTPROMOTER_API_KEY=

# Optional FirstPromoter account id. Defaults to or99bhsm when unset.
FIRSTPROMOTER_ACCOUNT_ID=

# Server-only n8n webhook for tracked referral signups. The URL must be https.
# Store both as Vercel Secrets. Never use a NEXT_PUBLIC_ prefix.
N8N_REFERRAL_WEBHOOK_URL=
N8N_REFERRAL_WEBHOOK_SECRET=

# Required for /checkout. Set the Revphlo application origin before building.
# Example: https://app.revphlo.com (use the actual application domain).
# HTTPS only in production; no path, query string, or trailing route.
NEXT_PUBLIC_REVPHLO_APP_URL=
